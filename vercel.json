{
  "version": 2,
  "buildCommand": "npm run build:all",
  "installCommand": "npm run install:all",

  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ],

  "functions": {
    "api/index.ts": {
      "maxDuration": 10,
      "memory": 1024
    }
  }
}
