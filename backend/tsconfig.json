{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    // "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "sourceMap": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
